# --- Öffentliche Adressen (über NPM) ---
YTS_BASE_URL=https://tube.isoletta.me
NTFY_PUBLIC_URL=https://push.tube.isoletta.me
YTS_TIMEZONE=Europe/Berlin

# --- Erster Elternteil (nur beim allerersten Start) ---
YTS_PARENT_NAME=Jessica
YTS_PARENT_EMAIL=
YTS_PARENT_PASSWORD=

# --- Datenbank ---
MARIADB_DATABASE=youtube_safe
MARIADB_USER=youtube_safe
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- ntfy: Token des Server-Benutzers (siehe deploy/README.md) ---
NTFY_TOKEN=

# --- Mail über Mailcow ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Ports auf 127.0.0.1 für NPM ---
YTS_APP_PORT=8090
YTS_NTFY_PORT=8091
