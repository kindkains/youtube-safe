{
  "_doc": "Gemeinsame Testfälle für ContentGate (Server: app/gate.py, App: core). Kind 1 ist das geprüfte Kind; Regeln mit child_id null gelten für alle Kinder.",
  "cases": [
    {"name": "ohne Regeln gesperrt",
     "rules": [], "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "default"}},
    {"name": "Kanal erlaubt",
     "rules": [{"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "allow"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": true, "reason": "channel_allow"}},
    {"name": "Kanal für alle erlaubt",
     "rules": [{"child_id": null, "target_type": "channel", "target_id": "c1", "effect": "allow"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": true, "reason": "channel_allow"}},
    {"name": "Regel eines anderen Kindes zählt nicht",
     "rules": [{"child_id": 2, "target_type": "channel", "target_id": "c1", "effect": "allow"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "default"}},
    {"name": "Video gesperrt schlägt Kanal erlaubt",
     "rules": [{"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "allow"},
               {"child_id": 1, "target_type": "video", "target_id": "v1", "effect": "block"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "video_block"}},
    {"name": "Video erlaubt schlägt Kanal gesperrt",
     "rules": [{"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "block"},
               {"child_id": 1, "target_type": "video", "target_id": "v1", "effect": "allow"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": true, "reason": "video_allow"}},
    {"name": "Kanal gesperrt",
     "rules": [{"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "block"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "channel_block"}},
    {"name": "Kind-Regel schlägt Regel für alle (Video)",
     "rules": [{"child_id": null, "target_type": "video", "target_id": "v1", "effect": "block"},
               {"child_id": 1, "target_type": "video", "target_id": "v1", "effect": "allow"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": true, "reason": "video_allow"}},
    {"name": "Kind-Regel schlägt Regel für alle (Kanal)",
     "rules": [{"child_id": null, "target_type": "channel", "target_id": "c1", "effect": "allow"},
               {"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "block"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "channel_block"}},
    {"name": "Belohnungsmodus öffnet Ungeregeltes",
     "rules": [], "video_id": "v1", "channel_id": "c1",
     "reward_active": true, "reward_includes_blocked": false,
     "expected": {"allowed": true, "reason": "reward"}},
    {"name": "Belohnungsmodus lässt Gesperrtes gesperrt",
     "rules": [{"child_id": 1, "target_type": "channel", "target_id": "c1", "effect": "block"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": true, "reward_includes_blocked": false,
     "expected": {"allowed": false, "reason": "channel_block"}},
    {"name": "Belohnungsmodus inklusive Gesperrtem",
     "rules": [{"child_id": 1, "target_type": "video", "target_id": "v1", "effect": "block"}],
     "video_id": "v1", "channel_id": "c1",
     "reward_active": true, "reward_includes_blocked": true,
     "expected": {"allowed": true, "reason": "reward_all"}},
    {"name": "inklusive Gesperrtem wirkt nur bei aktivem Belohnungsmodus",
     "rules": [], "video_id": "v1", "channel_id": "c1",
     "reward_active": false, "reward_includes_blocked": true,
     "expected": {"allowed": false, "reason": "default"}}
  ]
}
